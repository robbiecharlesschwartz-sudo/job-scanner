{
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "site",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- site/ api/ vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://job-scanner-app-mocha.vercel.app/",
      "permanent": false
    }
  ]
}
